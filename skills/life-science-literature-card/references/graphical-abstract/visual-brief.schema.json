{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "layout",
    "labels",
    "panels",
    "connectors",
    "numbers_in_image"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "layout": {
      "enum": [
        "simple",
        "complex",
        "triage"
      ]
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "role",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "title",
              "finding",
              "section",
              "method",
              "body",
              "footer"
            ]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "description",
          "label_ids"
        ]
      }
    },
    "connectors": {
      "type": "array"
    },
    "numbers_in_image": {
      "type": "array"
    },
    "text_overlay": {
      "const": false
    }
  }
}
