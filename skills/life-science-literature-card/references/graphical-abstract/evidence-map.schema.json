{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "paper_title_claim",
    "primary_endpoint",
    "main_figures",
    "modules",
    "integrated_conclusion",
    "tension",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "paper_title_claim": {
      "type": "string"
    },
    "primary_endpoint": {
      "type": "object",
      "required": [
        "name",
        "result",
        "significant",
        "source"
      ]
    },
    "main_figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "figure",
          "level",
          "method",
          "question",
          "finding",
          "evidence_strength",
          "source"
        ],
        "properties": {
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_strength": {
            "enum": [
              "primary",
              "secondary",
              "exploratory"
            ]
          },
          "level": {
            "enum": [
              "design",
              "whole_body",
              "circulation",
              "tissue",
              "cellular",
              "molecular",
              "population",
              "imaging",
              "model"
            ]
          }
        }
      }
    },
    "integrated_conclusion": {
      "type": "string"
    },
    "tension": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "locator"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          },
          "file_sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
