{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "paper_type",
    "card_tier",
    "complexity",
    "one_line_story",
    "key_concept_plain",
    "finding_shape",
    "sources",
    "main_findings",
    "must_not_show",
    "numbers_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "paper_type": {
      "enum": [
        "observational-cohort",
        "rct",
        "neuroimaging",
        "prediction-model",
        "genetic-mr",
        "systematic-review-meta",
        "basic-mechanism",
        "other"
      ]
    },
    "card_tier": {
      "enum": [
        "triage",
        "full"
      ]
    },
    "complexity": {
      "enum": [
        "simple",
        "complex"
      ]
    },
    "one_line_story": {
      "type": "string"
    },
    "key_concept_plain": {
      "type": "string"
    },
    "finding_shape": {
      "enum": [
        "contrast",
        "gradient",
        "trajectory",
        "mechanism_chain",
        "risk_stratification",
        "null_result",
        "mixed",
        "protocol"
      ]
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "locator"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          },
          "file_sha256": {
            "type": "string"
          }
        }
      }
    },
    "main_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding",
          "direction",
          "relation",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "increase",
              "decrease",
              "no_difference",
              "mixed",
              "uncertain",
              "not_applicable"
            ]
          },
          "relation": {
            "enum": [
              "association",
              "causal_evidence",
              "prediction",
              "mechanism",
              "planned"
            ]
          },
          "status": {
            "enum": [
              "changed",
              "associated",
              "supported",
              "null",
              "unconfirmed",
              "unsupported",
              "planned",
              "neutral"
            ]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "must_not_show": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "numbers_allowed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "outcomes_named": {
      "type": "array",
      "maxItems": 5
    },
    "evidence_map": {
      "type": "string"
    },
    "selected_modules": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complexity": {
            "const": "complex"
          },
          "card_tier": {
            "const": "full"
          }
        }
      },
      "then": {
        "required": [
          "evidence_map",
          "selected_modules"
        ]
      }
    }
  ]
}
