filters:
  and:
    - file.ext == "md"
    - note.note_type == "literature-card"
    - '!file.path.contains("/_backup/")'
formulas:
  placeholder_type: 'if(note.study_type == "observational-cohort", "observational-cohort", if(note.study_type == "rct", "rct", if(note.study_type == "prediction-model", "prediction-model", if(note.study_type == "genetic-mr", "genetic-mr", if(note.study_type == "basic-mechanism", "basic-mechanism", if(note.study_type == "neuroimaging", "neuroimaging", if(note.study_type == "systematic-review-meta", "systematic-review-meta", "other")))))))'
  display_cover: 'if(note.card_cover, note.card_cover, link("图片资源/literature_card_placeholders/" + formula.placeholder_type + ".svg"))'
  added: 'if(note.date_added, date(note.date_added), file.ctime)'
  verdict_display: 'if(note.verdict, note.verdict, "未评估")'
  type_display: 'if(note.study_type, note.study_type, "未分类")'
  project_group: 'if(note.projects, list(note.projects).join(" · "), "未关联")'
  week_start: 'today() - (duration("1d") * (number(today().format("E")) - 1))'
properties:
  note.journal:
    displayName: 期刊
  note.year:
    displayName: 年份
  note.card_summary:
    displayName: 一句话
  formula.verdict_display:
    displayName: 判断
  formula.type_display:
    displayName: 研究类型
  formula.added:
    displayName: 加入日期
  formula.project_group:
    displayName: 课题
views:
  - type: cards
    name: 全部
    order:
      - note.journal
      - note.year
      - formula.verdict_display
      - note.card_summary
    sort:
      - property: formula.added
        direction: DESC
    image: formula.display_cover
    cardSize: 260
    imageAspectRatio: 0.625
    imageFit: contain
  - type: cards
    name: 待精读
    filters:
      and:
        - note.verdict == "精读"
        - note.read_stage != "final_note"
    order:
      - note.journal
      - note.year
      - formula.verdict_display
      - note.card_summary
    sort:
      - property: formula.added
        direction: DESC
    image: formula.display_cover
    cardSize: 260
    imageAspectRatio: 0.625
    imageFit: contain
  - type: cards
    name: 按课题
    groupBy:
      property: formula.project_group
      direction: ASC
    order:
      - note.journal
      - note.year
      - formula.verdict_display
      - note.card_summary
    sort:
      - property: formula.added
        direction: DESC
    image: formula.display_cover
    cardSize: 260
    imageAspectRatio: 0.625
    imageFit: contain
  - type: cards
    name: 本周新增
    filters:
      and:
        - formula.added >= formula.week_start
        - formula.added <= now()
    order:
      - note.journal
      - note.year
      - formula.verdict_display
      - note.card_summary
    sort:
      - property: formula.added
        direction: DESC
    image: formula.display_cover
    cardSize: 260
    imageAspectRatio: 0.625
    imageFit: contain
